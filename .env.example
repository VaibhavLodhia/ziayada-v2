# Root-level .env — read by docker-compose for VARIABLE INTERPOLATION
# (the ${VAR} syntax inside docker-compose.dev.yml).
#
# Container-internal env vars live in services/backend/.env instead.
# Both files are gitignored. Never commit real secrets.

# Postgres password — used by the postgres service (and embedded into
# DATABASE_URL in services/backend/.env). Generate with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=replace-with-generated-password
