{
  "name": "ziyada-v2-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "npm run lint && npm run build",
    "preview": "vite preview",
    "gen:api": "npx -y openapi-typescript@6 http://localhost:8001/openapi.json -o src/lib/api-types.gen.ts",
    "gen:stream": "npx -y -p json-schema-to-typescript@13 json2ts -i ../../contracts/stream-events.schema.json -o src/lib/stream-events.gen.ts",
    "gen:types": "npm run gen:api && npm run gen:stream"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.439.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
