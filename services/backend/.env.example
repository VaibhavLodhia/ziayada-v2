APP_ENV=local
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5174

# Ollama Cloud exposes an OpenAI-compatible endpoint at /v1.
# Pick any cloud-suffixed model that supports tool calling:
#   qwen3.5:397b-cloud, nemotron-3-super:cloud, deepseek-v4-pro:cloud, ...
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace-me
OLLAMA_CHAT_MODEL=qwen3.5:397b-cloud

# ---------------------------------------------------------------------------
# xAI Realtime Voice — server-side only. Create at https://console.x.ai
# Enable the Voice endpoint on your API key. Never commit the real key.
XAI_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Postgres — backs the user/auth store AND the knowledge graph (Apache AGE
# runs inside this same Postgres). Use the same password you set in the ROOT
# .env (POSTGRES_PASSWORD). Hostname is "postgres" (the compose service) when
# running inside compose; use "localhost" when running uvicorn natively.
DATABASE_URL=postgresql+asyncpg://ziyada:replace-with-generated-password@postgres:5432/ziyada

# Graph name inside AGE (optional; defaults to "ziyada").
# AGE_GRAPH=ziyada

# ---------------------------------------------------------------------------
# JWT signing — used for the auth session cookie. ROTATE IF EVER LEAKED.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-hex-chars  # gitleaks:allow (placeholder, not a real secret)
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Admin bootstrap. On first boot, if no users exist AND both EMAIL and
# PASSWORD are set, the backend creates a user with role=admin using these
# values. Idempotent — skipped on subsequent boots.
# Remove these lines AFTER you've confirmed the admin exists and rotated the
# password through the admin panel. They are a one-shot hatch, not a backdoor.
# Generate with: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(18)))"
ADMIN_BOOTSTRAP_EMAIL=admin@ziyada.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-generated-password
ADMIN_BOOTSTRAP_NAME=Admin
